# Keep git history and secrets out of image layers, and the build context small.
#
# .git was being copied into images by `COPY . .`; one repo had a live PAT in
# .git/config, which then sat in an immutable image layer. Image layers can't be
# scrubbed after the fact, so exclude it at the source.

.git
.gitignore
.github/

# Secrets: supplied at runtime via compose env, never baked into an image.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
venv/
.venv/

# Node
node_modules/
npm-debug.log*

# Local scratch / editor noise
*.log
.DS_Store
Thumbs.db
